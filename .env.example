# Kopieer naar .env en vul in met de gegevens van je Supabase-project.
# Dashboard > Project Settings > Data API.
#
# Beide waarden komen in de publieke JS-bundle terecht. Dat hoort zo: de
# anon-key is bedoeld om publiek te zijn. Zet hier nooit de service-role-key
# neer — die omzeilt RLS en geeft volledige toegang tot de database.

VITE_SUPABASE_URL=https://JOUW_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=JOUW_ANON_KEY
